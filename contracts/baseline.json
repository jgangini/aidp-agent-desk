      },
      "InvokeRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Request Id"
          },
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          },
          "profile_id": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{32})?$",
            "title": "Profile Id",
            "default": ""
          },
          "session_id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "title": "Session Id",
            "default": ""
          },
          "action": {
            "type": "string",
            "enum": [
              "research",
              "replay",
              "cancel"
            ],
            "title": "Action",
            "default": "research"
          },
          "after_sequence": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "After Sequence",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "question"
        ],
        "title": "InvokeRequest"
      },
      "SpeechRequest": {
        "properties": {
          "profile_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
