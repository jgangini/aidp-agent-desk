{
  "name": "arko-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "generate": "openapi-typescript ../contracts/openapi.json -o src/shared/api.generated.ts",
    "test": "vitest run",
    "check": "node scripts/boundaries.mjs && tsc --noEmit && vitest run && vite build"
  },
  "dependencies": {"react": "^19.1.0", "react-dom": "^19.1.0", "openapi-fetch": "^0.15.0"},
  "devDependencies": {
    "@types/react": "^19.1.0", "@types/react-dom": "^19.1.0", "@types/node": "^22.15.0",
    "typescript": "~5.9.0", "vite": "^7.0.0", "vitest": "^3.2.0",
    "@testing-library/react": "^16.3.0", "jsdom": "^26.1.0", "openapi-typescript": "^7.8.0"
  }
}
