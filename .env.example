# Local setup can upload credentials; deployed connections are server-managed.
# Development default: .local/agent-desk. Never use VITE_* for credentials.
# AGENT_DESK_DATA_DIR=/private/path/agent-desk

AGENT_DESK_AUTH_MODE=local
# Server-only hosted settings; never use VITE_* for these values.
# AGENT_DESK_PUBLIC_ORIGIN=https://desk.example.com
# AGENT_DESK_OIDC_DOMAIN=https://your-domain.identity.oraclecloud.com
# AGENT_DESK_OIDC_CLIENT_ID=
# AGENT_DESK_OIDC_CLIENT_SECRET=
# AGENT_DESK_SESSION_SECRET=
# AGENT_DESK_ADMIN_SUBJECT=
# Deploy Studio uses directory:<immutable SCIM id> for the selected administrator.
# Directory login requires the Oracle application to emit sub=userName.
# AGENT_DESK_DIRECTORY_LOGIN=1
# Optional account provisioning, disabled by default; enabled requires OCI permissions.
# AGENT_DESK_CREATE_USERS=disabled
# ARKO_ALLOWED_HOSTS=desk.example.com,localhost,127.0.0.1
# Optional read-only base credentials, never included in the image.
# AGENT_DESK_BASE_CONFIG=/run/oci/config
# AGENT_DESK_BASE_KEY=/run/oci/key.pem
# AGENT_DESK_BASE_PROFILE=DEFAULT
# Deployment bootstrap sets both values; connection cannot be edited in the UI.
# AGENT_DESK_MANAGED_CONNECTION=1
# AGENT_DESK_COMPARTMENT_ID=ocid1.compartment.oc1..example
# Development only: Oracle login at http://127.0.0.1:8317 with a registered callback.
# AGENT_DESK_ALLOW_LOOPBACK_HTTP=1
# Enable reports only after verifying the exact agent candidate and its report capability.
# Comma-separated saved profile IDs; test:<id> enables TEST for local mode or authenticated Oracle administrators only.
# AGENT_DESK_REPORT_PROFILES=0123456789abcdef0123456789abcdef
