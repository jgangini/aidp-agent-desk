{
  "name": "agent-desk-frontend",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "generate": "openapi-typescript ../contracts/openapi.json -o src/shared/api.generated.ts",
    "test": "vitest run",
    "check": "node scripts/boundaries.mjs && tsc --noEmit && vitest run && vite build",
    "format": "prettier --write src vite.config.ts"
  },
  "dependencies": {
    "@a2ui/react": "0.15.0",
    "@a2ui/web_core": "0.15.0",
    "@assistant-ui/react": "^0.15.32",
    "@fontsource-variable/manrope": "^5.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.67.0",
    "openapi-fetch": "^0.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "simple-icons": "^16.36.0",
    "three": "^0.187.0",
    "voice-glow": "0.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "dompurify": "3.4.17"
  }
}
